#!/bin/sh
# .githooks/pre-push — Pre-push automated quality gate for anacatalina-mcp.
# Enable via: git config core.hooksPath .githooks

echo "Running pre-push quality gate..."

# 1. Verify ecosystem invariants
python scripts/verify_ecosystem_invariants.py
INV_EXIT=$?
if [ $INV_EXIT -ne 0 ]; then
  echo "Pre-push check failed: Ecosystem invariant violations detected."
  exit 1
fi

# 2. Run fast test suite
python -m pytest tests/ -q
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
  echo "Pre-push check failed: pytest test suite returned regressions ($TEST_EXIT)."
  exit 1
fi

echo "Pre-push quality gate passed successfully (100% test pass & zero invariant regressions)."
exit 0
